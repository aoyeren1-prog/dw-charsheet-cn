            "bonds": {"title": "关系", "type": "bonds", "resetOnClassChange": true, "relations": false}, 
            "notes": {"title": "笔记", "type": "fillbox", "addCounter": true}, 
            "starting": {"title": "起始动作", "type": "moveList"}, 
            "advanced": {
                "title": "进阶动作", 
                "type": "moveList", 
                "groups": [
                    {"key": "2+", "label": "当你升级时，从下列动作中选择：", "minLevel": 2, "moves": []}, 
                    {"key": "custom", "label": "其他", "moves": []}

            "drive": {
                "title": "动机", 
                "note": "选择一项", 
                "type": "moveList", 
                "buttons": [ {"label": "动机", "position": "global", "action": "addMove"} ], 
                "selectMoves": true
            }, 
            "gear": {
                "title": "装备", 
                "rightStats": [ {"key": "load", "label": "负载上限", "type": "number", "min": 0} ], 
                "type": "fillbox", 
                "resetOnClassChange": true, 
                "counters": [ {"key": "coins", "label": "货币"} ]

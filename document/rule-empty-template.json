                "buttons": [
                    {
                        "label": "自定义", 
                        "position": "global", 
                        "action": "addMove", 
                        "targetGroup": "custom"
                    }
                ], 
                "selectMoves": true
            }
        },
        "areaLayout": {
            "left": ["look", "background", "drive", "heritage", "gear", "bonds", "notes"], 
            "right": ["starting", "advanced"]
        }
